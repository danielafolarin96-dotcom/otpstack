# Copy to .env.local and fill in real values. Never commit .env.local.

# 5sim.net — server-only, used in lib/5sim/client.ts
5SIM_API_KEY=

# Paystack — secret key is server-only; public key is safe client-side
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Supabase — anon key is safe client-side; service role key is server-only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
