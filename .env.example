# Copy to .env.local and fill in real values. Never commit .env.local.

# 5sim.net — server-only, used in lib/5sim/client.ts
FIVESIM_API_KEY=

# Paystack — secret key is server-only; public key is safe client-side
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Supabase — anon key is safe client-side; service role key is server-only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret protecting /api/cron/expire-orders — not a third-party
# credential, generate your own (e.g. `openssl rand -hex 32`) and set the
# same value in Vercel's project env vars once connected.
CRON_SECRET=
